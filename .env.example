APP_RELEASE_STORE_PASSWORD=
APP_RELEASE_KEY_PASSWORD=

FIREBASE_FUNCTIONS_URL=

# Debug tokens (only for local development)
APPCHECK_DEBUG_TOKEN_ANDROID=
APPCHECK_DEBUG_TOKEN_IOS=

# 账号（Supabase Auth，邮箱 + 密码）。国内经北京机中转：https://<IP>:18443/pw
# 中转证书需同时打包进 android/app/src/main/res/raw 并在 network_security_config 固定。
ACCOUNT_API_URL=
ACCOUNT_PUBLISHABLE_KEY=

# 应用内更新（可选）：额外的 update.json 地址，多个用英文逗号分隔。
# 留空也能更新：App 内置 GitCode（国内快）和 GitHub 两处的 update.json 地址，同时请求，谁快用谁。
UPDATE_MANIFEST_URL=

# App Configuration
APP_URL=pocketwisdom://app
